**\u0422\u0438\u043F\u0438\u0447\u043D\u044B\u0435 workflows:**

\u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u0437\u0430\u043C\u0435\u0442\u043A\u0438:
1. \u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443 \u043F\u0430\u043F\u043A\u0438
2. \u0421\u043E\u0437\u0434\u0430\u0442\u044C \u0437\u0430\u043C\u0435\u0442\u043A\u0443 \u0441 \u0448\u0430\u0431\u043B\u043E\u043D\u043E\u043C
3. \u0421\u0432\u044F\u0437\u0430\u0442\u044C \u0441 \u0438\u043D\u0434\u0435\u043A\u0441\u043E\u043C (\u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0441\u0441\u044B\u043B\u043A\u0443 \u0432 \u0441\u043F\u0438\u0441\u043E\u043A)

\u0420\u0435\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u0434\u043B\u0438\u043D\u043D\u043E\u0439 \u0437\u0430\u043C\u0435\u0442\u043A\u0438:
1. \u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435 \u0434\u043B\u044F \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B
2. \u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u0444\u0430\u0439\u043B\u044B \u0434\u043B\u044F \u043A\u0440\u0443\u043F\u043D\u044B\u0445 \u0440\u0430\u0437\u0434\u0435\u043B\u043E\u0432
3. \u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u043E\u0441\u043D\u043E\u0432\u043D\u0443\u044E \u0437\u0430\u043C\u0435\u0442\u043A\u0443 \u0441\u043E \u0441\u0441\u044B\u043B\u043A\u0430\u043C\u0438 \u043D\u0430 \u043D\u043E\u0432\u044B\u0435 \u0444\u0430\u0439\u043B\u044B

\u041C\u0430\u0441\u0441\u043E\u0432\u043E\u0435 \u043F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u0442\u0435\u0440\u043C\u0438\u043D\u0430:
1. \u041D\u0430\u0439\u0442\u0438 \u0432\u0441\u0435 \u0444\u0430\u0439\u043B\u044B \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0435 \u0442\u0435\u0440\u043C\u0438\u043D \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0438\u0441\u043A
2. \u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0444\u0430\u0439\u043B\u044B \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u0430
3. \u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C \u0437\u0430\u043C\u0435\u043D\u0443 \u0432\u043E \u0432\u0441\u0435\u0445 \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0445 \u0444\u0430\u0439\u043B\u0430\u0445

\u0420\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u043A\u043D\u0438\u0433\u0438 \u043D\u0430 \u0433\u043B\u0430\u0432\u044B:
1. \u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u043D\u0430\u0447\u0430\u043B\u043E \u0434\u043B\u044F \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043A\u043E\u0432
2. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u043F\u043E \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043A\u0430\u043C
3. \u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043E\u0433\u043B\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0441\u043E \u0441\u0441\u044B\u043B\u043A\u0430\u043C\u0438 \u043D\u0430 \u0432\u0441\u0435 \u0433\u043B\u0430\u0432\u044B

\u0418\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0439 \u0433\u043B\u0430\u0432\u044B:
1. \u0418\u0437\u0432\u043B\u0435\u0447\u044C \u0433\u043B\u0430\u0432\u0443 \u043F\u043E \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043A\u0443 \u0432 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0444\u0430\u0439\u043B
2. \u041E\u0442\u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0438\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u043D\u0443\u044E \u0433\u043B\u0430\u0432\u0443
3. \u041F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0438\u043B\u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E

\u0420\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0433\u043B\u043E\u0441\u0441\u0430\u0440\u0438\u044F \u043D\u0430 \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0438:
1. \u041F\u0440\u043E\u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443 \u0433\u043B\u043E\u0441\u0441\u0430\u0440\u0438\u044F
2. \u0418\u0437\u0432\u043B\u0435\u0447\u044C \u043A\u0430\u0436\u0434\u0443\u044E \u0437\u0430\u043F\u0438\u0441\u044C \u043F\u043E \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043A\u0443
3. \u0418\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u043D\u0430 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u0444\u0430\u0439\u043B\u044B

\u0421\u0431\u043E\u0440\u043A\u0430 \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0430 \u0438\u0437 \u0440\u0430\u0437\u043D\u044B\u0445 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432:
1. \u0418\u0437\u0432\u043B\u0435\u0447\u044C \u043D\u0443\u0436\u043D\u044B\u0435 \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B \u0438\u0437 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430
2. \u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B \u0438\u0437 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432 \u0432 \u043A\u043E\u043D\u0435\u0446
3. \u041F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442\u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0438\u0442\u043E\u0433\u043E\u0432\u044B\u0439 \u0444\u0430\u0439\u043B
`.trim(),As=`
**\u0412\u0430\u0436\u043D\u044B\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F \u0438 \u043E\u0448\u0438\u0431\u043A\u0438:**

\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043B\u0438\u043C\u0438\u0442\u044B:
- \u041C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 10 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u0432 \u0431\u0430\u0442\u0447\u0435
- \u041C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 1 \u041C\u0411 \u043D\u0430 \u0444\u0430\u0439\u043B
- \u0421\u0438\u0441\u0442\u0435\u043C\u043D\u0430\u044F \u043F\u0430\u043F\u043A\u0430 zFlowWriter-ai \u0437\u0430\u0449\u0438\u0449\u0435\u043D\u0430 \u043E\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u0430
- \u0417\u0430\u043F\u0440\u0435\u0449\u0435\u043D\u043D\u044B\u0435 \u0441\u0438\u043C\u0432\u043E\u043B\u044B \u0432 \u043F\u0443\u0442\u044F\u0445: <>:"|?*

\u0427\u0430\u0441\u0442\u044B\u0435 \u043E\u0448\u0438\u0431\u043A\u0438:
- "\u0424\u0430\u0439\u043B \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D" \u2192 \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u043F\u0443\u0442\u044C, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 search
- "\u041F\u0430\u043F\u043A\u0430 \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442" \u2192 write \u0441\u043E\u0437\u0434\u0430\u0441\u0442 \u0435\u0451 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
- "\u0414\u043E\u0441\u0442\u0443\u043F \u0437\u0430\u043F\u0440\u0435\u0449\u0435\u043D" \u2192 \u041D\u0435 \u043F\u044B\u0442\u0430\u0439\u0442\u0435\u0441\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0441 \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u043E\u0439 \u043F\u0430\u043F\u043A\u043E\u0439
- "\u0420\u0430\u0437\u043C\u0435\u0440 \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D" \u2192 \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 offset/limit \u0434\u043B\u044F \u0447\u0442\u0435\u043D\u0438\u044F \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u0444\u0430\u0439\u043B\u043E\u0432
- "\u0422\u0435\u043A\u0441\u0442 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D" (replace) \u2192 \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C \u0432 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438 \u0438\u0441\u043A\u043E\u043C\u043E\u0439 \u0441\u0442\u0440\u043E\u043A\u0438

\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0434\u0430\u043D\u043D\u044B\u0445:
- \u0423\u0434\u0430\u043B\u0451\u043D\u043D\u044B\u0435 \u0444\u0430\u0439\u043B\u044B \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u044E\u0442\u0441\u044F \u0432 backup \u043F\u0430\u043F\u043A\u0443
- \u0412\u0441\u0435 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044E \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438
- \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u043A\u0430\u0442\u0438\u0442\u044C \u043B\u044E\u0431\u043E\u0435 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0447\u0435\u0440\u0435\u0437 UI
`.trim(),Ps=`
**\u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C\u044B\u0439 \u043F\u043E\u0434\u0445\u043E\u0434 \u043A \u0440\u0430\u0431\u043E\u0442\u0435:**

Workflow \u0434\u043B\u044F \u0441\u043B\u043E\u0436\u043D\u044B\u0445 \u0437\u0430\u0434\u0430\u0447:
1. \u041F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 - \u0441\u043E\u0437\u0434\u0430\u0439\u0442\u0435 \u0441\u043F\u0438\u0441\u043E\u043A \u0437\u0430\u0434\u0430\u0447 \u0447\u0435\u0440\u0435\u0437 WriteToDo (\u0435\u0441\u043B\u0438 \u0437\u0430\u0434\u0430\u0447\u0430 \u0441\u043B\u043E\u0436\u043D\u0430\u044F)
2. \u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435 - \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 list/search \u0434\u043B\u044F \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B
3. \u0427\u0442\u0435\u043D\u0438\u0435 - \u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0444\u0430\u0439\u043B\u044B \u043F\u0435\u0440\u0435\u0434 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C
4. \u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435 - \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 (write/append/replace)
5. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 - \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
6. \u0421\u0432\u044F\u0437\u044B\u0432\u0430\u043D\u0438\u0435 - \u043E\u0431\u043D\u043E\u0432\u0438\u0442\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435 \u0437\u0430\u043C\u0435\u0442\u043A\u0438 \u0438 \u0438\u043D\u0434\u0435\u043A\u0441\u044B
7. \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 - \u043E\u0431\u043D\u043E\u0432\u0438\u0442\u0435 \u0441\u0442\u0430\u0442\u0443\u0441 \u0437\u0430\u0434\u0430\u0447

\u0418\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u0444\u0430\u0439\u043B\u043E\u0432:
- \u041E\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B\u0435 \u0438\u043C\u0435\u043D\u0430: "\u0413\u043B\u0430\u0432\u043D\u044B\u0439 \u0433\u0435\u0440\u043E\u0439 - \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F.md"
- \u0411\u0435\u0437 \u0441\u043F\u0435\u0446\u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432: <>:"|?*
- \u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435 .md \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0434\u043B\u044F \u0437\u0430\u043C\u0435\u0442\u043E\u043A

