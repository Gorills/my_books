**\u0421\u0418\u0421\u0422\u0415\u041C\u041D\u041E\u0415 \u0423\u0412\u0415\u0414\u041E\u041C\u041B\u0415\u041D\u0418\u0415:**
\u0412\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442\u0435 \u043A\u0430\u043A \u0441\u0443\u0431\u0430\u0433\u0435\u043D\u0442. \u042D\u0442\u0443 \u0437\u0430\u0434\u0430\u0447\u0443 \u0432\u0430\u043C \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0430\u0433\u0435\u043D\u0442-\u043E\u0440\u043A\u0435\u0441\u0442\u0440\u0430\u0442\u043E\u0440.
\u041F\u043E\u0441\u043B\u0435 **\u043F\u043E\u043B\u043D\u043E\u0433\u043E** \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F \u0437\u0430\u0434\u0430\u0447\u0438, \u0432\u044B **\u043E\u0431\u044F\u0437\u0430\u043D\u044B** \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043E\u0442\u0447\u0435\u0442 \u043E \u043F\u0440\u043E\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u0435 \u043E\u0440\u043A\u0435\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u0443, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \`report\`.

**\u0412\u0410\u0416\u041D\u041E:** \u041E\u0442\u043F\u0440\u0430\u0432\u043A\u0430 \u043E\u0442\u0447\u0435\u0442\u0430 \u2014 \u044D\u0442\u043E \u0432\u0430\u0448\u0435 **\u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435**. \u0421\u0440\u0430\u0437\u0443 \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u0432\u0430\u0448\u0430 \u0441\u0435\u0441\u0441\u0438\u044F \u0431\u0443\u0434\u0435\u0442 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430, \u0438 \u0432\u044B \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u044B. \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E \u0437\u0430\u0434\u0430\u0447\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0440\u0435\u0448\u0435\u043D\u0430 \u043F\u0435\u0440\u0435\u0434 \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u043E\u0439 \u043E\u0442\u0447\u0435\u0442\u0430.`,w=r.inputEl;if(!w)throw new Error("\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u043F\u043E\u043B\u044E \u0432\u0432\u043E\u0434\u0430");if(w.value=f,w.dispatchEvent(new Event("input")),w.focus(),w.setSelectionRange(f.length,f.length),n){if(await r.sendMessage(),new Mi.Notice(`\u041F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u0441\u0443\u0431\u0430\u0433\u0435\u043D\u0442\u0443: \xAB${s}\xBB. \u0420\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u0430\u0433\u0435\u043D\u0442 \u043E\u0436\u0438\u0434\u0430\u0435\u0442 \u043E\u0442\u0447\u0435\u0442\u0430.`),d)return d;throw new Error("\u041E\u0448\u0438\u0431\u043A\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F pend