/* =============================
   Flow Writer Plugin Settings UI
   Стили для контейнеров опций настроек и элементов управления
   ============================= */

/* Акцентный пункт контекстного меню */
.flow-writer-menu-item-accent {
  background-color: var(--interactive-accent) !important;
  color: var(--text-on-accent) !important;
}

.flow-writer-menu-item-accent:hover {
  background-color: var(--interactive-accent-hover) !important;
}

.flow-writer-menu-item-accent .menu-item-icon {
  color: var(--text-on-accent) !important;
}

.fw-setting-row {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 12px 16px;
  margin-bottom: 8px;
  border-radius: 8px;
  background: var(--background-secondary);
}
.fw-setting-label {
  flex: 0 0 260px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
}
.fw-setting-label-title {
  font-weight: 500;
  line-height: 1.2;
}
.fw-setting-label-description {
  font-size: 0.95em;
  color: var(--text-muted);
  line-height: 1.2;
}
.fw-setting-select {
  width: 100%;
  min-width: 180px;
  max-width: 400px;
  height: 32px;
  color: var(--text-normal);
  font-size: 0.95em;
  box-sizing: border-box;
  outline: none;
  transition: all 0.15s ease;
  text-align: center; /* Выравниваем текст по центру */
  
  /* Создание эффекта вдавленности */
  background-color: var(--background-primary-alt, var(--background-secondary-alt));
  border: 1px solid var(--background-modifier-border-hover, var(--background-modifier-border));
  border-radius: 6px;
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.08), 
              inset 0 0 2px rgba(0, 0, 0, 0.04);
  padding: 0 12px;
}

/* Стиль при наведении и фокусе */
.fw-setting-select:hover {
  background-color: var(--background-primary);
}

.fw-setting-select:focus {
  border-color: var(--interactive-accent);
  background-color: var(--background-primary);
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.06),
              0 0 0 2px var(--interactive-accent-hover, hsla(var(--accent-h), var(--accent-s), var(--accent-l), 0.2));
}

.fw-setting-input.fw-setting-select {
  width: 100%;
  min-width: 180px;
  max-width: 400px;
  height: 32px;
  color: var(--text-normal);
  font-size: 0.95em;
  box-sizing: border-box;
  outline: none;
  transition: all 0.15s ease;
  text-align: center;
  background-color: var(--background-primary-alt, var(--background-secondary-alt));
  border: 1px solid var(--background-modifier-border-hover, var(--background-modifier-border));
  border-radius: 6px;
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.08), 
              inset 0 0 2px rgba(0, 0, 0, 0.04);
  padding: 0 12px;
}

.fw-setting-input.fw-setting-select:hover {
  background-color: var(--background-primary);
}

.fw-setting-input.fw-setting-select:focus {
  border-color: var(--interactive-accent);
  background-color: var(--background-primary);
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.06),
              0 0 0 2px var(--interactive-accent-hover, hsla(var(--accent-h), var(--accent-s), var(--accent-l), 0.2));
}

.fw-setting-control {
  flex: 1;
  display: flex;
  align-items: center;
  position: relative; /* Для абсолютного позиционирования контейнера засечек */
  padding-bottom: 0px; /* Убираем отступ, т.к. засечки теперь на уровне слайдера */
}

/* Более специфичные стили для контейнера элементов управления */
.fw-setting-row .fw-setting-control {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  width: 100%;
  justify-content: flex-end;
}

/* Более специфичное определение для выравнивания полей формы */
.fw-setting-row .fw-setting-control {
  flex: 1 1 auto !important;
  display: flex !important;
  width: 100% !important;
  max-width: none !important;
  justify-content: flex-end !important;
}

.fw-setting-control input.fw-setting-input.fw-setting-select,
.fw-setting-control select.fw-setting-select {
  width: 100%;
  flex: 1;
}

/* Принудительное растягивание выпадающего списка */
.fw-setting-select, 
select.fw-setting-select,
.fw-setting-input.fw-setting-select {
  width: 100% !important;
  min-width: 180px !important;
  max-width: none !important;
}

/* Убедиться, что контейнер элемента управления занимает всю доступную ширину */
.fw-clean-setting .fw-setting-control {
  width: 100% !important;
}

/* Styles for slider ticks */
.fw-slider-ticks-container {
  position: absolute;
  bottom: calc(50% - 3px); /* Центрируем контейнер вертикально */
  left: 10px;     /* Увеличенный отступ слева для соответствия слайдеру */
  right: 10px;    /* Увеличенный отступ справа для соответствия слайдеру */
  height: 6px;    /* Высота области засечек */
  pointer-events: none; /* Засечки не мешают взаимодействию */
  z-index: 1;     /* Засечки под ползунком */
  opacity: 0.7;   /* Увеличиваем непрозрачность для лучшей видимости */
}

/* Для более точного позиционирования используем стиль для слайдера и margin вместо отступов */
.fw-setting-slider {
  width: calc(100% - 20px) !important; /* Устанавливаем явную ширину с учетом отступов */
  margin: 0 10px !important; /* Центрируем слайдер */
}

.fw-slider-tick {
  position: absolute;
  width: 2px;
  /* Цвет засечек светлее, чем у ползунка */
  background-color: var(--background-modifier-border-hover, #e0e0e0);
  height: 4px;
  top: 50%;
  transform: translateY(-50%);
  border-radius: 1px;
  box-shadow: 0 0 1px var(--background-secondary);
}

/* Делаем нулевую и конечную засечки немного выше для акцента */
.fw-slider-tick.tick-val-0,
.fw-slider-tick.tick-val-35 {
  height: 6px; /* Более высокие крайние засечки */
  width: 2px; /* Такая же толщина, как у обычных засечек */
}

/* Классы для позиционирования засечек для слайдера cacheDuration (0-35, шаг 5) */
/* Используем новую формулу для более точного позиционирования */
.fw-slider-tick.tick-val-0   { left: 0; margin-left: -1px; } /* Сдвигаем на половину ширины влево */
.fw-slider-tick.tick-val-5   { left: calc( (5 / 35) * 100% - 1px); } /* Учитываем ширину засечки */
.fw-slider-tick.tick-val-10  { left: calc( (10 / 35) * 100% - 1px); }
.fw-slider-tick.tick-val-15  { left: calc( (15 / 35) * 100% - 1px); }
.fw-slider-tick.tick-val-20  { left: calc( (20 / 35) * 100% - 1px); }
.fw-slider-tick.tick-val-25  { left: calc( (25 / 35) * 100% - 1px); }
.fw-slider-tick.tick-val-30  { left: calc( (30 / 35) * 100% - 1px); }
.fw-slider-tick.tick-val-35  { left: calc(100% - 1px); } /* Сдвигаем на половину ширины влево */

/* Стили для отключенных настроек кэширования запросов */
.fw-setting-disabled {
  opacity: 0.6;
  cursor: not-allowed;
  /* Убираем pointer-events: none, чтобы корректно обрабатывать клик */
}

/* Добавляем блокировку элементов управления внутри отключенной настройки */
.fw-setting-disabled .fw-setting-slider,
.fw-setting-disabled input,
.fw-setting-disabled button {
  pointer-events: none !important;
}

/* Улучшаем реакцию на наведение, чтобы подсказка не вызывала скачков */
.fw-setting-disabled:hover::before {
  content: 'Требуется указать API-ключ для этой опции';
  position: absolute;
  bottom: calc(100% + 10px);
  left: 50%;
  transform: translateX(-50%);
  background: var(--background-secondary-alt);
  padding: 6px 10px;
  border-radius: 4px;
  z-index: 100;
  font-size: 0.9em;
  white-space: nowrap;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  border: 1px solid var(--background-modifier-border);
  pointer-events: none;
}

/* Добавляем плейсхолдер для подсказки, чтобы не было скачков */
.fw-setting-disabled::after {
  content: '';
  display: block;
  position: absolute;
  height: 0;
  width: 100%;
  top: -10px;
  left: 0;
  pointer-events: none;
}

.fw-api-key-required {
  color: var(--text-muted);
  font-size: 0.8em;
  font-style: italic;
  margin-left: 8px;
  white-space: nowrap;
}

/* Индикатор недоступности опции */
.fw-setting-disabled .fw-setting-label-title::after {
  content: '';
  display: inline-block;
  width: 8px;
  height: 8px;
  margin-left: 8px;
  border-radius: 50%;
  background-color: var(--text-muted);
}

/* Подсказка при наведении на отключенный элемент */
.fw-setting-disabled:hover {
  position: relative;
}

/* =============================
    Стили для ответов ИИ в редакторе
   ============================= */

.callout[data-callout="ai-answer"] {
  --callout-color: var(--interactive-accent);
  --callout-icon: bot-message-square;
  border-radius: 12px;
  border-left: 4px solid var(--interactive-accent);
  background-color: hsla(var(--accent-h), var(--accent-s), var(--accent-l), 0.05);
  padding: 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0);
}
.callout[data-callout="ai-answer"] .callout-title {
  padding: 12px 16px;
  font-weight: 500;
  letter-spacing: -0.01em;
  display: flex;
  align-items: center;
  gap: 8px;
}
.callout[data-callout="ai-answer"] .callout-content {
  padding: 0 16px 16px;
  line-height: 1.5;
}
.callout[data-callout="ai-answer"] .callout-icon {
  font-size: 1.1em;
}
.callout[data-callout="ai-answer-accepted"] {
  --callout-color: var(--interactive-accent);
  --callout-icon: pin;
  border-radius: 12px;
  border: 1px solid var(--interactive-accent);
  border-left: 4px solid var(--interactive-accent);
  background-color: hsla(var(--accent-h), var(--accent-s), var(--accent-l), 0.05);
  padding: 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0);
}
.callout[data-callout="ai-answer-accepted"] .callout-title {
  padding: 12px 16px;
  font-weight: 500;
  letter-spacing: -0.01em;
  display: flex;
  align-items: center;
  gap: 8px;
}
.callout[data-callout="ai-answer-accepted"] .callout-content {
  padding: 0 16px 16px;
  line-height: 1.5;
}
.callout[data-callout="ai-answer-accepted"] .callout-icon {
  font-size: 1.1em;
}

/* =============================
   Auth UI Styles
   ============================= */

.fw-auth-controls-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
}
.fw-auth-status-nowrap {
    white-space: nowrap;
}

.fw-auth-status .fw-setting-label-description { 
    font-weight: bold;
}

.fw-auth-buttons-control {
    display: flex;
    gap: 10px; 
}

.fw-auth-notice {
    padding: 10px;
    background-color: var(--background-secondary-alt);
    border: 1px solid var(--background-modifier-border);
    border-radius: var(--radius-m);
    margin-top: 15px;
    text-align: center;
    font-size: var(--font-ui-small);
}

.fw-ai-config-auth-space {
  height: 18px;
  width: 100%;
}

/* Центрирование для заглушки авторизации */
.fw-ai-config-auth-centered {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 32px;
  text-align: center;
}

/* =============================
   Модальные окна FlowWriter
   ============================= */

.ai-modal-flex {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.ai-modal-custom {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  height: 70vh;
  width: 70vw;
}

.ai-modal-title {
  font-size: 1.3em;
  font-weight: 700;
  margin-bottom: 18px;
  margin-top: 0; /* Было 1em, теперь 0 */
  text-align: center;
  flex-shrink: 0;
}

.ai-modal-textarea {
  width: 100%;
  flex-grow: 1;
  font-size: 1.1em;
  padding: 12px;
  margin-bottom: 10px;
  border-radius: 8px;
  border: 1px solid var(--background-modifier-border);
  background: var(--background-secondary);
  color: var(--text-normal);
  resize: vertical;
  box-sizing: border-box;
  transition: border-color 0.15s ease;
}

.ai-modal-textarea:hover {
  border-color: var(--background-modifier-border-hover);
}

.ai-modal-textarea:focus {
  outline: none;
  border-color: var(--interactive-accent);
  box-shadow: none;
}

/* Универсальный футер для кнопок и чекбоксов */
.ai-modal-footer {
  display: flex;
  align-items: center;
  justify-content: space-between; /* Изменено с center на space-between */
  gap: 16px;
  margin-top: 18px;
  width: 100%;
}

/* Новый контейнер для кнопок */
.ai-modal-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-grow: 1; /* Занимает все доступное пространство */
}

/* Стили для чекбокса и его контейнера */
.ai-modal-checkbox-container {
  display: flex;
  align-items: center;
  font-size: 0.9em;
  flex-shrink: 0; /* Не сжимается */
  margin-left: 0; /* Убираем отступ слева, теперь он не нужен */
}

/* Удаляем старые контейнеры */
.ai-modal-actions-container { display: none !important; }

/* Стили для выделенного текста */
.ai-modal-selected {
  width: 100%;
  background: var(--background-primary-alt);
  color: var(--text-normal);
  border-radius: 6px;
  padding: 10px;
  margin-bottom: 16px;
  font-family: inherit;
  font-size: 1em;
  white-space: pre-wrap;
  word-break: break-word;
  border: 1px solid var(--background-modifier-border);
  overflow-y: auto;
  max-height: 150px;
}

/* Стиль для меток полей */
.ai-modal-label {
  font-size: 1em;
  margin-bottom: 4px;
  font-weight: 500;
}

/* Стили для чекбокса и его контейнера */
.ai-modal-checkbox-container {
  display: flex;
  align-items: center;
  font-size: 0.9em;
  flex-shrink: 0; /* Не сжимается */
  margin-left: 0; /* Убираем отступ слева, теперь он не нужен */
}

.ai-modal-checkbox {
  margin-right: 8px;
}

.ai-modal-checkbox-label {
  display: inline-block;
  max-width: 90px;
  line-height: 1.2;
  text-align: left;
}

/* Панель промптов в модальном окне - невидимая */
.ai-modal-prompts-panel {
  /* Намеренно оставлено пустым - панель должна быть невидимой */
  display: block;
}

.ai-modal-prompts-empty {
  color: var(--text-muted);
  font-size: 13px;
  font-style: italic;
  padding: 8px;
}

.ai-modal-prompts-container {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  max-height: 120px;
  overflow-y: auto;
  margin: 8px 0;
}

/* Кнопки промптов - радужные градиенты с динамикой как у карточек статистики */
.ai-modal-prompt-btn {
  padding: 0 16px;
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  border: none;
  border-radius: 12px;
  color: white;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: opacity 0.2s ease;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 32px;
  line-height: 1;
  position: relative;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.ai-modal-prompt-btn:hover {
  filter: brightness(1.1);
  opacity: 0.95;
}

.ai-modal-prompt-btn:active {
  transform: translateY(1px);
  opacity: 0.8;
}

/* Радужная последовательность градиентов - яркая современная палитра */
.ai-modal-prompt-btn:nth-child(7n+1) {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF5252 100%); /* красный */
}

.ai-modal-prompt-btn:nth-child(7n+2) {
  background: linear-gradient(135deg, #FF9F43 0%, #FF6348 100%); /* оранжевый */
}

.ai-modal-prompt-btn:nth-child(7n+3) {
  background: linear-gradient(135deg, #FFD93D 0%, #FFC048 100%); /* желтый */
  color: #333;
}

.ai-modal-prompt-btn:nth-child(7n+4) {
  background: linear-gradient(135deg, #6BCF7F 0%, #4CAF50 100%); /* зеленый */
}

.ai-modal-prompt-btn:nth-child(7n+5) {
  background: linear-gradient(135deg, #4ECDC4 0%, #00D9FF 100%); /* голубой */
}

.ai-modal-prompt-btn:nth-child(7n+6) {
  background: linear-gradient(135deg, #748FFC 0%, #5E72E4 100%); /* синий */
}

.ai-modal-prompt-btn:nth-child(7n) {
  background: linear-gradient(135deg, #C471ED 0%, #A55EEA 100%); /* фиолетовый */
}

/* Кнопка добавления нового промпта - нейтральный стиль */
.ai-modal-prompt-btn-add {
  background: linear-gradient(135deg, #E5E7EB 0%, #D1D5DB 100%) !important;
  color: #374151 !important;
  border: 1px solid #9CA3AF;
  font-weight: 600;
  letter-spacing: 0.5px;
  padding: 0 20px;
  height: 32px;
  line-height: 1;
}

.ai-modal-prompt-btn-add:hover {
  background: linear-gradient(135deg, #D1D5DB 0%, #9CA3AF 100%) !important;
  filter: brightness(1.1);
  opacity: 0.95;
}

.ai-modal-prompt-btn-add:active {
  transform: translateY(1px);
  opacity: 0.8;
}

/* Поле ввода для модальных окон промптов */
.ai-modal-input,
input.ai-modal-input {
  width: 100%;
  padding: 8px 12px;
  background: var(--background-primary);
  border: 1px solid var(--background-modifier-border) !important;
  border-radius: 6px;
  color: var(--text-normal);
  font-size: 14px;
  margin-bottom: 12px;
  min-height: 36px;
  line-height: 1.5;
  transition: border-color 0.15s ease;
}

.ai-modal-input:hover,
input.ai-modal-input:hover {
  border-color: var(--background-modifier-border-hover) !important;
}

.ai-modal-input:focus,
input.ai-modal-input:focus {
  outline: none !important;
  border-color: var(--interactive-accent) !important;
  box-shadow: none !important;
}

/* Специальные стили для select в модальных окнах */
select.ai-modal-input {
  appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' width='292' height='292'%3e%3cpath fill='%23637282' d='M287 69l-141 142-141-142c-5-5-13-5-18 0s-5 13 0 18l150 150c5 5 13 5 18 0l150-150c5-5 5-13 0-18s-13-5-18 0z'/%3e%3c/svg%3e");
  background-repeat: no-repeat;
  background-position: right 12px center;
  background-size: 12px;
  padding-right: 36px;
  cursor: pointer;
}

/* Большая textarea для редактирования промптов */
.ai-modal-textarea-large {
  min-height: 200px;
  max-height: 400px;
  border: 1px solid var(--background-modifier-border);
  transition: border-color 0.15s ease;
}

.ai-modal-textarea-large:hover {
  border-color: var(--background-modifier-border-hover);
}

.ai-modal-textarea-large:focus {
  outline: none;
  border-color: var(--interactive-accent);
  box-shadow: none;
}


/* Стили других модальных окон, если нужны
Например, если поля ввода в модальных окнах требуют специфичной ширины */
.modal-content .fw-input { /* Предполагая, что инпуты в модалках имеют класс fw-input */
    width: 100%;
    margin-bottom: 10px;
}

/* =============================
   AI Loading Indicator (Header)
   ============================= */
.ai-loading-action {
  display: none;
  align-items: center;
  gap: 4px;
}
.ai-loading-action svg {
  animation: ai-spin 1s linear infinite;
}
.ai-loading-action.is-sending {
  display: inline-flex;
  color: var(--interactive-accent);
}
@keyframes ai-spin {
  100% {
    transform: rotate(360deg);
  }
}
.ai-loading-text {
  white-space: nowrap;
  overflow: visible;
  min-width: max-content;
  display: inline-block;
}
.view-action.ai-loading-action {
  flex-shrink: 0;
  z-index: 2;
}

/* =============================
   Flow Writer Header Actions UI
   Стили для кнопок и контейнера действий в хедере заметки
   ============================= */

   .fw-plugin-actions {
  display: flex;
  align-items: center;
  gap: var(--size-4-2);
}
.view-header > .view-actions {
  margin-left: auto;
}
/* Стили наведения для кнопок хедера заметок */
.fw-plugin-actions .ai-send-action:hover svg,
.fw-plugin-actions .ai-accept-action:hover svg,
.fw-plugin-actions .ai-keep-action:hover svg,
.fw-plugin-actions .ai-toggle-reference-action:hover svg,
.fw-plugin-actions .ai-toggle-prompts-action:hover svg {
  color: var(--interactive-accent);
}

/* Кнопка отмены - красный цвет при наведении */
.fw-plugin-actions .ai-cancel-action:hover svg {
  color: var(--color-red);
}

/* Кнопка удаления - красный цвет при наведении */
.fw-plugin-actions .ai-reject-action:hover svg {
  color: var(--color-red);
}

/* Стили для кнопки отмены генерации в чате */
.ai-chat-send-button-cancel svg {
  color: var(--color-red);
}

/* Анимация подсветки поля API-ключа */
@keyframes fw-highlight-pulse {
  0% { box-shadow: 0 0 0 0 rgba(var(--interactive-accent-rgb), 0.7); }
  70% { box-shadow: 0 0 0 6px rgba(var(--interactive-accent-rgb), 0); }
  100% { box-shadow: 0 0 0 0 rgba(var(--interactive-accent-rgb), 0); }
}

.fw-highlight-field {
  animation: fw-highlight-pulse 1.5s ease-in-out;
  border-color: var(--interactive-accent) !important;
}

/* Стили для контейнера чекбокса запоминания API-ключа */
.fw-setting-controls-right {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 120px;
  justify-content: center;
}

/* Контейнер для чекбокса с подписью */
.fw-setting-checkbox-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
}

.fw-checkbox-label {
  font-size: 11px;
  color: var(--text-muted);
  cursor: pointer;
  user-select: none;
  line-height: 1.2;
  white-space: nowrap;
}

.checkbox-container {
  display: flex;
  align-items: center;
  gap: 6px;
}

/* ======================== */
/* Единый стиль кнопок для плагина */
/* ======================== */
/* ВАЖНО: Все классы задаются в TypeScript коде при создании кнопки,
 * НЕ изменяйте этот CSS файл для добавления функциональности!
 * 
 * Базовый класс: .fw-button
 * Модификаторы: .secondary, .danger, .compact, .wide
 * 
 * Примеры использования в .ts файлах:
 * button.className = 'fw-button'; // Основная кнопка
 * button.className = 'fw-button secondary'; // Вторичная кнопка
 * button.className = 'fw-button danger'; // Кнопка опасного действия
 * button.className = 'fw-button compact'; // Компактная кнопка
 * button.className = 'fw-button wide'; // Широкая кнопка
 * 
 * Для обработки нажатия Enter добавьте класс mod-cta в коде:
 * button.className = 'mod-cta fw-button'; // Кнопка с обработкой Enter
 * button.className = 'mod-cta fw-button secondary wide'; // Комбинация
 */
.fw-button {
  /* Базовые размеры и отступы */
  min-width: 140px;
  padding: 10px 24px;
  height: 32px;
  
  /* Визуальное оформление */
  background-color: var(--interactive-accent) !important;
  color: var(--text-on-accent) !important;
  border: none;
  border-radius: 8px;
  
  /* Типографика */
  font-size: 14px;
  font-weight: 600;
  text-align: center;
  
  /* Интерактивность */
  cursor: pointer;
  transition: all 0.15s ease;
  
  /* Flexbox для центрирования содержимого */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  
  /* Убираем стандартные стили */
  outline: none;
  box-shadow: none;
}

/* Состояние при наведении */
.fw-button:hover {
  filter: brightness(1.1);
  opacity: 0.95;
}

/* Состояние при фокусе (для поддержки Enter) */
.fw-button:focus {
  box-shadow: 0 0 0 2px var(--background-primary), 
              0 0 0 4px var(--interactive-accent);
}

/* Состояние при нажатии */
.fw-button:active {
  transform: translateY(1px);
  opacity: 0.8;
}

/* Вариант вторичной кнопки */
.fw-button.secondary {
  background-color: var(--background-secondary-alt) !important;
  color: var(--text-normal) !important;
  border: 1px solid var(--background-modifier-border);
}

.fw-button.secondary:hover {
  filter: brightness(1.1);
  opacity: 0.95;
}

/* Вариант кнопки опасного действия */
.fw-button.danger {
  background-color: var(--text-error) !important;
  color: var(--text-on-accent) !important;
}

.fw-button.danger:hover {
  filter: brightness(1.1);
  opacity: 0.95;
}

/* =============================
   Индикаторы генерации на вкладках
   ============================= */

/* Вкладка с активной генерацией - акцентный фон */
.workspace-tab-header[data-flowwriter-generating="true"] {
  background-color: hsla(var(--accent-h), var(--accent-s), var(--accent-l), 0.15) !important;
}

/* Вкладка с завершенной генерацией - приглушенный фон с рамкой */
.workspace-tab-header[data-flowwriter-generated="true"] {
  background-color: hsla(var(--accent-h), var(--accent-s), var(--accent-l), 0.05) !important;
  border: 1px solid var(--interactive-accent) !important;
}

/* Компактный вариант */
.fw-button.compact {
  min-width: auto;
  padding: 6px 16px;
  height: 28px;
  font-size: 13px;
}

/* Широкий вариант */
.fw-button.wide {
  min-width: 200px;
}

/* Состояние отключенной кнопки */
.fw-button:disabled,
.fw-button.disabled {
  opacity: 0.5;
  cursor: not-allowed;
  pointer-events: none;
}

/* =============================
   Панель промптов в хедере
   ============================= */

/* Панель промптов - вторая строка под хедером */
.fw-header-prompts-panel {
    display: flex;
    align-items: center;
    padding: 4px 16px; /* Увеличиваем вертикальные отступы для лучшего размещения кнопок */
    background: transparent; /* Используем прозрачный фон, чтобы наследовать цвет контейнера */
    border-bottom: 1px solid var(--background-modifier-border);
    width: 100%;
    box-sizing: border-box;
    min-height: auto; /* Позволяем панели адаптироваться под содержимое */
}

/* Адаптация контейнера промптов для панели в хедере */
.fw-header-prompts-panel .ai-modal-prompts-container {
    max-height: none;
    overflow-y: visible;
    margin: 0;
    width: 100%;
}

/* Адаптация кнопок промптов в хедере - убеждаемся что они помещаются */
.fw-header-prompts-panel .ai-modal-prompt-btn,
.fw-header-prompts-panel .ai-modal-prompt-btn-add {
    height: 28px; /* Фиксированная высота для кнопок в хедере */
    flex-shrink: 0; /* Не позволяем кнопкам сжиматься */
}

/* Сообщение об ошибке в хедере */
.fw-header-prompts-error {
    color: var(--text-error);
    font-size: 13px;
}
